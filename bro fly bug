local function EnableNoClip()
    NoClip = true
    ToggleNoClip.Text = "穿墙: 开"
    ToggleNoClip.TextColor3 = Color3.fromRGB(100, 255, 100)
    
    for _, part in ipairs(Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

local function DisableNoClip()
    NoClip = false
    ToggleNoClip.Text = "穿墙: 关"
    ToggleNoClip.TextColor3 = Color3.fromRGB(255, 200, 100)
    
    for _, part in ipairs(Character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = true
        end
    end
end

local function StartFlying()
    if isFlying then return end
    
    if HumanoidRootPart:FindFirstChildOfClass("BodyVelocity") then
        HumanoidRootPart:FindFirstChildOfClass("BodyVelocity"):Destroy()
    end
    if HumanoidRootPart:FindFirstChildOfClass("BodyGyro") then
        HumanoidRootPart:FindFirstChildOfClass("BodyGyro"):Destroy()
    end
    
    BV = Instance.new("BodyVelocity")
    BV.Name = "FlightBV"
    BV.Parent = HumanoidRootPart
    BV.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    BV.Velocity = Vector3.new(0, 0, 0)
    
    BG = Instance.new("BodyGyro")
    BG.Name = "FlightBG"
    BG.Parent = HumanoidRootPart
    BG.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    BG.D = 500
    BG.P = 10000
    BG.CFrame = HumanoidRootPart.CFrame
    
    isFlying = true
    StatusDisplay.Text = "状态: 飞行中"
    StatusDisplay.TextColor3 = Color3.fromRGB(100, 255, 100)
    ToggleFly.Text = "关闭飞行"
    ToggleFly.TextColor3 = Color3.fromRGB(255, 100, 100)
    Humanoid.PlatformStand = true
    
    if NoClip then
        EnableNoClip()
    end
end

local function StopFlying()
    if not isFlying then return end
    
    if BV then BV:Destroy() end
    if BG then BG:Destroy() end
    
    isFlying = false
    StatusDisplay.Text = "状态: 就绪"
    StatusDisplay.TextColor3 = Color3.fromRGB(200, 255, 200)
    ToggleFly.Text = "启动飞行"
    ToggleFly.TextColor3 = Color3.fromRGB(100, 255, 100)
    Humanoid.PlatformStand = false
    
    DisableNoClip()
end

ToggleFly.MouseButton1Click:Connect(function()
    if isFlying then
        StopFlying()
    else
        StartFlying()
    end
end)

SpeedUp.MouseButton1Click:Connect(function()
    FlySpeed = math.min(FlySpeed + SpeedIncrement, MaxFlySpeed)
    SpeedDisplay.Text = "速度: "..FlySpeed
end)

SpeedDown.MouseButton1Click:Connect(function()
    FlySpeed = math.max(FlySpeed - SpeedIncrement, MinFlySpeed)
    SpeedDisplay.Text = "速度: "..FlySpeed
end)

ToggleNoClip.MouseButton1Click:Connect(function()
    if NoClip then
        DisableNoClip()
    else
        EnableNoClip()
    end
end)

StopFly.MouseButton1Click:Connect(function()
    StopFlying()
    HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
    HumanoidRootPart.RotVelocity = Vector3.new(0, 0, 0)
end)

local function CloseGUI()
    MainFrame.Visible = false
    ReopenButton.Visible = true
end

local function ReopenGUI()
    MainFrame.Visible = true
    ReopenButton.Visible = false
end

CloseButton.MouseButton1Click:Connect(CloseGUI)
ReopenButton.MouseButton1Click:Connect(ReopenGUI)

local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera

local function UpdateFlight(dt)
    if not isFlying or not BV or not BG then return end
    
    BG.CFrame = Camera.CFrame
    
    local direction = Vector3.new(0, 0, 0)
    
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then
        direction = direction + Camera.CFrame.LookVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then
        direction = direction - Camera.CFrame.LookVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then
        direction = direction - Camera.CFrame.RightVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then
        direction = direction + Camera.CFrame.RightVector
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        direction = direction + Vector3.new(0, 1, 0)
    end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
        direction = direction + Vector3.new(0, -1, 0)
    end
    
    if direction.Magnitude > 0 then
        direction = direction.Unit * FlySpeed
    end
    
    BV.Velocity = direction
    
    if NoClip then
        for _, part in ipairs(Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end

game:GetService("RunService").Heartbeat:Connect(UpdateFlight)

